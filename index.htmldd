<style>
.patents-featured{position:relative;overflow:hidden}.patent-intro{display:flex;justify-content:space-between;align-items:center;gap:32px;margin-bottom:34px}.patent-intro h2{font-size:clamp(32px,4vw,48px);line-height:1.12;letter-spacing:-1.8px;margin:12px 0}.patent-lead{color:var(--muted);font-size:14px;max-width:690px}.patent-highlight{flex:0 0 180px;padding:19px 22px;border:1px solid #3b716e;border-radius:12px;background:linear-gradient(145deg,#12343a,#102238);display:flex;align-items:center;gap:15px}.patent-highlight strong{font-size:48px;line-height:1;color:var(--teal)}.patent-highlight span{font:10px/1.6 "DM Mono",monospace;color:#c6d8e4}.patent-family{border:1px solid #3a7772;border-radius:15px;overflow:hidden;background:linear-gradient(125deg,#102c37,#0d1c2d 70%);box-shadow:0 18px 55px #0003;margin-bottom:18px}.family-heading{display:flex;align-items:center;gap:16px;padding:17px 24px 0}.family-kicker,.related-label{font:10px "DM Mono",monospace;letter-spacing:1.5px;color:var(--teal)}.family-line{height:1px;flex:1;background:linear-gradient(90deg,#397b78,transparent)}.family-main{display:grid;grid-template-columns:1fr 190px;gap:30px;padding:23px 25px 27px}.family-copy h3{font-size:clamp(21px,2.5vw,29px);line-height:1.3;letter-spacing:-.7px;max-width:800px;margin:13px 0}.family-copy>p{font-size:13px;color:#b1c3d2;max-width:780px}.patent-status{font:10px "DM Mono",monospace;letter-spacing:1.1px}.patent-status.granted{color:#70e5c9}.patent-status.pending{color:#e6bd73}.patent-status.published{color:#83c8ff}.patent-meta{display:flex;flex-wrap:wrap;gap:8px;margin:17px 0}.patent-meta span{font:9px "DM Mono",monospace;color:#c0d1df;border:1px solid #315066;border-radius:5px;padding:6px 8px}.patent-document-link{display:inline-flex;gap:18px;align-items:center;margin-top:5px;color:var(--teal);font-size:12px;font-weight:800;border-bottom:1px solid #397b78;padding-bottom:5px}.family-badge{border-left:1px solid #315465;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:10px}.badge-orbit{width:75px;height:75px;border:1px solid #5de0c5;border-radius:50%;display:grid;place-items:center;color:var(--teal);font:24px "DM Mono",monospace;box-shadow:0 0 0 9px #5de0c510,0 0 35px #5de0c522;margin-bottom:17px}.family-badge strong{font-size:12px;line-height:1.5}.family-badge small{color:#8ea8bc;font:9px "DM Mono",monospace;margin-top:8px}.family-related{border-top:1px solid #2b4d5e;background:#0b1b2b;padding:16px 25px;display:flex;justify-content:space-between;align-items:center;gap:20px}.family-related strong{display:block;color:#edf5fb;font:16px "DM Mono",monospace;margin:5px 0}.family-related p{font-size:11px;color:#91a8bb;margin:0;max-width:680px}.family-related>a{font-size:11px;color:var(--teal);font-weight:800;white-space:nowrap}.patent-grid-updated{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.patent-grid-updated .patent-card{padding:23px 24px 20px;min-height:235px;background:linear-gradient(145deg,#102238,#0c1a2a)}.patent-granted{border-color:#326b62}.patent-application{border-color:#67563a}.patent-card-top{display:flex;align-items:center;justify-content:space-between}.patent-number{font:11px "DM Mono",monospace;color:#69849a}.patent-grid-updated .patent-card h3{font-size:18px;line-height:1.4;margin:18px 0 9px}.patent-id{display:block;font:12px "DM Mono",monospace;color:#d6e5ef}.patent-grid-updated .patent-card p{min-height:0;margin:11px 0 18px}.patent-kind{display:inline-block;font:9px "DM Mono",monospace;letter-spacing:.7px;color:#a9c0d0;border:1px solid #2c465c;border-radius:4px;padding:5px 7px}.patent-new-record{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:16px;padding:20px 23px;border:1px solid #31506a;border-radius:10px;background:#0b1b2a}.patent-new-record h3{font-size:17px;margin:8px 0 5px}.patent-new-record p{font-size:11px;color:#9eb1c2;max-width:790px;margin:0}.patent-new-record>strong{font:12px "DM Mono",monospace;color:#c8d9e7;white-space:nowrap}.patent-note{font-size:10px;color:#8399ac;line-height:1.7;max-width:1000px;margin-top:19px}
@media(max-width:680px){.patent-intro{display:block}.patent-highlight{margin-top:20px;width:max-content}.family-main{grid-template-columns:1fr;padding:20px}.family-badge{display:none}.family-related{align-items:flex-start;flex-direction:column;padding:16px 20px}.patent-grid-updated{grid-template-columns:1fr}.patent-new-record{align-items:flex-start;flex-direction:column}}
</style>

